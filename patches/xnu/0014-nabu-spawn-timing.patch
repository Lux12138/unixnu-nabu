+/*
+ * nabu: read-only GICv3 state for the exec probes.  Nothing here writes to the
+ * GIC; the values tell us whether the interrupt controller is actually armed.
+ *   GICD  0x17a00000 (0x10000)   GICR 0x17a60000 (0x100000), stride 0x20000
+ *   (from dts/nabu-full.dts interrupt-controller@17a00000)
+ */
+static vm_offset_t nabu_gicd_base;
+static vm_offset_t nabu_gicr_base;
+static vm_offset_t nabu_gicr_region;
+static uint64_t nabu_gicr_phys;
+static uint32_t nabu_gicr_aff;
+
+/*
+ * GICR frames are not guaranteed to be in affinity order (l425 read a frame that
+ * was never written while ICC/GICD clearly were): pick the frame whose
+ * GICR_TYPER affinity matches this core's MPIDR, exactly like the platform kext.
+ */
+static vm_offset_t
+nabu_gicr_pick(vm_offset_t base, uint64_t size)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	uint32_t want = (uint32_t)((mpidr & 0xffffffULL) | ((mpidr >> 8) & 0xff000000ULL));
+
+	for (uint64_t off = 0; off + 0x20000 <= size; off += 0x20000) {
+		uint64_t typer = *(volatile uint64_t *)(base + off + 0x8);
+		if ((uint32_t)(typer >> 32) == want) {
+			nabu_gicr_aff = (uint32_t)(typer >> 32);
+			return base + off;
+		}
+		if ((typer & 0x10ULL) != 0) {
+			break;
+		}
+	}
+	return base;
+}
+
+static void
+nabu_gic_map(void)
+{
+	vm_offset_t region;
+	uint32_t override = 0;
+	extern int PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int max_len);
+
+	if (nabu_gicd_base != 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("nabu-gicr-base", &override, sizeof(override)) != 1) {
+		override = 0;
+	}
+	nabu_gicr_phys = override ? (uint64_t)override : 0x17a60000ULL;
+	nabu_gicd_base = ml_io_map(0x17a00000ULL, 0x10000ULL);
+	region = ml_io_map(nabu_gicr_phys, 0x100000ULL);
+	nabu_gicr_region = region;
+	nabu_gicr_base = region ? nabu_gicr_pick(region, 0x100000ULL) : 0;
+}
+
+static uint32_t
+nabu_gic_read(uint32_t which)
+{
+	if (nabu_gicd_base == 0) {
+		nabu_gic_map();
+	}
+	switch (which) {
+	case 0: /* GICD_CTLR */
+		return nabu_gicd_base ? *(volatile uint32_t *)(nabu_gicd_base + 0x0000) : 0xdead0000;
+	case 1: /* GICR_WAKER */
+		return nabu_gicr_base ? *(volatile uint32_t *)(nabu_gicr_base + 0x0014) : 0xdead0001;
+	case 2: /* GICR_ISENABLER0 (SGI_base = frame + 0x10000) */
+		return nabu_gicr_base ? *(volatile uint32_t *)(nabu_gicr_base + 0x10000 + 0x0100) : 0xdead0002;
+	case 3: /* GICR_IGROUPR0 (SGI_base) */
+		return nabu_gicr_base ? *(volatile uint32_t *)(nabu_gicr_base + 0x10000 + 0x0080) : 0xdead0003;
+	case 4: /* GICR_CTLR (RD_base) */
+		return nabu_gicr_base ? *(volatile uint32_t *)(nabu_gicr_base + 0x0000) : 0xdead0008;
+	default: /* GICR_IGRPMODR0 (SGI_base) */
+		return nabu_gicr_base ? *(volatile uint32_t *)(nabu_gicr_base + 0x10000 + 0x0d00) : 0xdead0009;
+	}
+}
+
+uint32_t
+nabu_gicr_ctlr(void)
+{
+	return nabu_gic_read(4);
+}
+
+uint32_t
+nabu_gicr_igrpmodr0(void)
+{
+	return nabu_gic_read(5);
+}
+
+uint32_t
+nabu_gicd_ctlr(void)
+{
+	return nabu_gic_read(0);
+}
+
+uint32_t
+nabu_gicr_waker(void)
+{
+	return nabu_gic_read(1);
+}
+
+uint32_t
+nabu_gicr_isen(void)
+{
+	return nabu_gic_read(2);
+}
+
+uint32_t
+nabu_gicr_igroupr0(void)
+{
+	return nabu_gic_read(3);
+}
+
+/* ICC_* are undefined if the system-register interface is off: check SRE first. */
+uint32_t
+nabu_icc_sre(void)
+{
+	return (uint32_t)__builtin_arm_rsr64("ICC_SRE_EL1");
+}
+
+uint32_t
+nabu_icc_pmr(void)
+{
+	if ((nabu_icc_sre() & 1) == 0) {
+		return 0xdead0004;
+	}
+	return (uint32_t)__builtin_arm_rsr64("ICC_PMR_EL1");
+}
+
+uint32_t
+nabu_icc_igrpen1(void)
+{
+	if ((nabu_icc_sre() & 1) == 0) {
+		return 0xdead0005;
+	}
+	return (uint32_t)__builtin_arm_rsr64("ICC_IGRPEN1_EL1");
+}
+
+/* Which GICR frame the readback above came from (0 = fallback: first frame). */
+uint32_t
+nabu_gicr_affinity(void)
+{
+	nabu_gic_map();
+	return nabu_gicr_aff;
+}
+
+/* This core's MPIDR and the TYPER affinity word of redistributor frame `index`. */
+uint64_t
+nabu_mpidr(void)
+{
+	return __builtin_arm_rsr64("MPIDR_EL1");
+}
+
+uint32_t
+nabu_gicr_typer(uint32_t index)
+{
+	nabu_gic_map();
+	if (nabu_gicr_region == 0 || index > 3) {
+		return 0xdeadbeefU;
+	}
+	return *(volatile uint32_t *)(nabu_gicr_region + (uint64_t)index * 0x20000ULL + 0xC);
+}
