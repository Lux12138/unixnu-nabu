+/*
+ * nabu: kernel-side GICv3 bring-up, gated behind "nabu-gic-kick=1".
+ * Same register values as ArmCpu::enableGic(); idempotent.  Needed when the
+ * platform kext never reaches enableGic() (ArmCpu::start() bails out if
+ * prepareGic() fails), in which case the CPU interface stays closed and no
+ * interrupt - including the virtual timer PPI 27 - is ever signalled.
+ */
+extern int PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int max_len);
+extern uint64_t mach_absolute_time(void);
+
+static int nabu_gic_kick_done;
+
+static boolean_t
+nabu_gic_wait_rwp(volatile uint32_t *ctlr)
+{
+	uint64_t deadline = mach_absolute_time() + 19200000ULL * 2;
+	while ((*ctlr & (1U << 31)) != 0) {
+		if (mach_absolute_time() > deadline) {
+			return FALSE;
+		}
+	}
+	return TRUE;
+}
+
+void
+nabu_gic_kick(void)
+{
+	int on = 0;
+	uint32_t ctl, waker;
+	volatile uint32_t *gicd;
+	volatile uint32_t *gicr;
+	uint64_t deadline;
+
+	if (nabu_gic_kick_done != 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("nabu-gic-kick", &on, sizeof(on)) != 1 || on == 0) {
+		return;
+	}
+	nabu_gic_kick_done = 1;
+
+	nabu_gic_map();
+	if (nabu_gicd_base == 0 || nabu_gicr_base == 0) {
+		printf("nabu: gic-kick map failed gd=%lx gr=%lx\n",
+		    (unsigned long)nabu_gicd_base, (unsigned long)nabu_gicr_base);
+		return;
+	}
+	gicd = (volatile uint32_t *)nabu_gicd_base;
+	gicr = (volatile uint32_t *)nabu_gicr_base;
+
+	/*
+	 * Never unmask an interrupt source unless the CPU has a handler installed:
+	 * sleh_irq() calls cdp->interrupt_handler unconditionally.
+	 */
+	if (getCpuDatap()->interrupt_handler == NULL) {
+		printf("nabu: gic-kick skipped, no handler gd=%08x i=%x/%x/%x cv=%x/%llx\n",
+		    gicd[0], nabu_icc_sre(), nabu_icc_pmr(), nabu_icc_igrpen1(),
+		    (uint32_t)__builtin_arm_rsr64("CNTV_CTL_EL0"),
+		    (unsigned long long)__builtin_arm_rsr64("CNTV_TVAL_EL0"));
+		return;
+	}
+
+	/* Locate the live redistributor: scan 0x17a00000..0x17c00000 step 0x20000 and report
+	 * the first frame whose GICR_TYPER is present (a dead/unmapped page reads 0). */
+	{
+		vm_offset_t scan_base = ml_io_map(0x17a00000ULL, 0x200000ULL);
+		uint64_t found = 0;
+		uint32_t ftyper = 0;
+
+		if (scan_base != 0) {
+			for (uint64_t off = 0x60000; off < 0x200000; off += 0x20000) {
+				uint64_t t = *(volatile uint64_t *)(scan_base + off + 0x8);
+				if (t != 0 && t != 0xffffffffffffffffULL) {
+					found = 0x17a00000ULL + off;
+					ftyper = (uint32_t)(t >> 32);
+					break;
+				}
+			}
+			printf("nabu: gic-scan pid=%08x found=%llx aff=%08x\n",
+			    *(volatile uint32_t *)(scan_base + 0xfe8),
+			    (unsigned long long)found, ftyper);
+		} else {
+			printf("nabu: gic-scan map failed\n");
+		}
+	}
+
+	ctl = gicd[0];
+	gicd[0] = ctl & ~3U;
+	(void)nabu_gic_wait_rwp(gicd);
+	gicd[0] = (ctl & ~3U) | 16U;
+	(void)nabu_gic_wait_rwp(gicd);
+	gicd[0] = (ctl & ~3U) | 16U | 2U;
+	(void)nabu_gic_wait_rwp(gicd);
+
+	waker = gicr[0x14 / 4];
+	gicr[0x14 / 4] = waker & ~2U;
+	deadline = mach_absolute_time() + 19200000ULL * 2;
+	while ((gicr[0x14 / 4] & 4U) != 0) {
+		if (mach_absolute_time() > deadline) {
+			break;
+		}
+	}
+
+	/* Group 1 = bit set. The timer PPI must be group 1 so it arrives as IRQ (our IRQ path calls rtclock_intr). */
+	gicr[(0x10000 + 0x80) / 4] = gicr[(0x10000 + 0x80) / 4] | (1U << 27);
+	gicr[(0x10000 + 0x100) / 4] = (1U << 27) | 0xffffU;
+
+	if ((nabu_icc_sre() & 1U) == 0) {
+		__builtin_arm_wsr64("ICC_SRE_EL1", 1);
+		__builtin_arm_isb(ISB_SY);
+	}
+	__builtin_arm_wsr64("ICC_CTLR_EL1", __builtin_arm_rsr64("ICC_CTLR_EL1") & ~2ULL);
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+	__builtin_arm_wsr64("ICC_PMR_EL1", 0xff);
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+
+	/* Force the virtual timer to assert: enable, unmask, arm 1 ms (19200 @19.2 MHz). */
+	{
+		uint64_t ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
+		ctl |= 1ULL;
+		ctl &= ~2ULL;
+		__builtin_arm_wsr64("CNTV_CTL_EL0", ctl);
+		__builtin_arm_isb(ISB_SY);
+		__builtin_arm_wsr64("CNTV_TVAL_EL0", 19200ULL);
+		__builtin_arm_isb(ISB_SY);
+	}
+
+	printf("nabu: gic-kick gb=%llx h=%p ty=%08x gd=%08x gw=%08x ge=%08x gg=%08x gc=%08x gm=%08x i=%x/%x/%x hp=%x rp=%x cv=%x/%llx\n",
+	    (unsigned long long)nabu_gicr_phys, (void *)getCpuDatap()->interrupt_handler, nabu_gicr_aff,
+	    gicd[0], gicr[0x14 / 4], gicr[(0x10000 + 0x100) / 4], gicr[(0x10000 + 0x80) / 4],
+	    nabu_gicr_ctlr(), nabu_gicr_igrpmodr0(),
+	    nabu_icc_sre(), nabu_icc_pmr(), nabu_icc_igrpen1(),
+	    nabu_icc_hppir1(), nabu_icc_rpr(),
+	    (uint32_t)__builtin_arm_rsr64("CNTV_CTL_EL0"),
+	    (unsigned long long)__builtin_arm_rsr64("CNTV_TVAL_EL0"));
+}
