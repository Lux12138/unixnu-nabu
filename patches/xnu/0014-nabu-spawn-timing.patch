+/*
+ * nabu: read-only views of Apple's own per-CPU counters so the exec probes can
+ * tell three cases apart: (a) decrementer interrupts never arrive, (b) no
+ * interrupts reach this CPU at all, (c) the probe reads a stale plane.
+ * All fields are from cpu_data_t.cpu_stat (cpu_stat_t in arm/cpu_data_internal.h):
+ *   irq_ex_cnt - bumped by the assembly IRQ entry (genassym.c CPU_STAT_IRQ)
+ *   ipi_cnt    - bumped in this file at cpu_common.c:581
+ */
+uint64_t
+nabu_timer_ticks(void)
+{
+	return getCpuDatap()->cpu_stat.timer_cnt;
+}
+
+uint32_t
+nabu_timer_deadline(void)
+{
+	return getCpuDatap()->cpu_decrementer;
+}
+
+uint64_t
+nabu_irq_count(void)
+{
+	return getCpuDatap()->cpu_stat.irq_ex_cnt;
+}
+
+uint64_t
+nabu_ipi_count(void)
+{
+	return getCpuDatap()->cpu_stat.ipi_cnt;
+}
+
+uint32_t
+nabu_irqs_enabled(void)
+{
+	return ml_get_interrupts_enabled() ? 1u : 0u;
+}
