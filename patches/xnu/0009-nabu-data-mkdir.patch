+/* Kernel-side mkdir by path string. mkdir1at() is static, so the boot code that
+ * assembles the Data skeleton cannot call it directly. UIO_SYSSPACE keeps the path
+ * a kernel pointer. */
+int
+nabu_kern_mkdir(const char *path, int mode)
+{
+	struct vnode_attr va;
+
+	if (path == NULL || mode <= 0) {
+		return EINVAL;
+	}
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode);
+	return mkdir1at(vfs_context_kernel(), (user_addr_t)(uintptr_t)path, &va, AT_FDCWD,
+	    UIO_SYSSPACE);
+}
+
+
+/* Kernel-side whole-file write by path string, for the same reason as
+ * nabu_kern_mkdir: the boot code that prepares the Data tree runs on the kernel
+ * context, so the path stays a kernel pointer (UIO_SYSSPACE). */
+int
+nabu_kern_write_file(const char *path, const char *data, size_t len, int mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error;
+
+	if (path == NULL || (data == NULL && len != 0)) {
+		return EINVAL;
+	}
+	error = vnode_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)len, 0,
+	    UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), NULL, NULL);
+	if (vnode_close(vp, FWASWRITTEN, ctx) != 0 && error == 0) {
+		error = EIO;
+	}
+	return error;
+}
+
+
+/* Same as nabu_kern_write_file(), but the owner and mode are restated on the vnode the write already
+ * holds and returned per file. l537 is why: all five preference writes returned success while the
+ * attribute loop's own vnode_lookup() of those very same paths came back ENOENT, so nobody could tell
+ * the file from the path from the attribute step -- and 0600/501:501 never landed. A preference file
+ * the mobile-side cfprefsd cannot open is a silent no-op, so the ownership is part of the write, not a
+ * separate pass that may or may not find the file. */
+int
+nabu_kern_write_file_owner(const char *path, const char *data, size_t len, int mode, uid_t uid,
+    gid_t gid)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error;
+
+	if (path == NULL || (data == NULL && len != 0)) {
+		return EINVAL;
+	}
+	error = vnode_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)len, 0,
+	    UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), NULL, NULL);
+	if (error == 0) {
+		struct vnode_attr va;
+
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, mode & 07777);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, gid);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	if (vnode_close(vp, FWASWRITTEN, ctx) != 0 && error == 0) {
+		error = EIO;
+	}
+	return error;
+}
+
+
+/* Read back the first `cap` bytes of a path, together with the size the vnode itself reports. The
+ * skip-Setup writer can only ever say that vn_rdwr() returned 0; it cannot say what is on the file,
+ * and a preferences reader that cannot parse a plist falls back to its defaults without reporting
+ * anything. O_RDONLY without O_CREAT is also the control half of this helper: a path that is not
+ * there comes back ENOENT, which is what turns a zero from the six real reads into evidence instead
+ * of a reader that "succeeds" at everything. This tree's prototype is bsd/sys/vnode.h:2332 --
+ * vn_rdwr(rw, vp, base, len, offset, segflg, ioflg, cred, int *aresid, proc_t p) -- so the residual
+ * count comes back through an int and p stays NULL, exactly the shape nabu_kern_write_file() uses. */
+int
+nabu_kern_read_file_head(const char *path, char *out, size_t cap, size_t *got,
+    unsigned long long *fsize, unsigned *gset)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int aresid = 0;
+	int error;
+
+	if (path == NULL || out == NULL || cap == 0 || got == NULL || fsize == NULL || gset == NULL) {
+		return EINVAL;
+	}
+	*got = 0;
+	*fsize = 0;
+	*gset = 0;
+	error = vnode_open(path, O_RDONLY, 0, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	VATTR_INIT(&va);
+	/* l543: XNU fills a vnode_attr according to the request bits -- this same file's exec path does
+	 * VATTR_WANTED(vap, va_data_size) immediately before vnode_getattr() (kern_exec.c:6551), and a few
+	 * lines later refuses a zero-length image (kern_exec.c:6566). l541 only did VATTR_INIT, so the field
+	 * was never asked for and I printed 0. Ask for it the way this tree does, and also report whether
+	 * the filesystem set the bit (gset=), because a size of 0 must not be able to mean two things.
+	 * VATTR_WANTED sets va_active; the filesystem's answer lands in va_supported -- there is no va_set
+	 * member, and the first l543 build failed on exactly that. */
+	VATTR_WANTED(&va, va_data_size);
+	*gset = 0;
+	if (vnode_getattr(vp, &va, ctx) == 0) {
+		*fsize = (unsigned long long) va.va_data_size;
+		*gset = VATTR_IS_SUPPORTED(&va, va_data_size) ? 1U : 0U;
+	}
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)(uintptr_t)out, (int)cap, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &aresid, NULL);
+	if (error == 0 && aresid >= 0 && aresid <= (int)cap) {
+		*got = cap - (size_t)aresid;
+	}
+	(void) vnode_close(vp, 0, ctx);
+	return error;
+}
