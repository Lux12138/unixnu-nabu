+		unsigned attr_ok = 0, attr_fail = 0;
+		const char *badPath = 0;
+		int badError = 0;
+		for (unsigned i = 0; i < sizeof(writable) / sizeof(writable[0]); i++) {
+			struct vnode_attr va;
+			vfs_context_t ctx = vfs_context_kernel();
+			vnode_t vp = NULLVP;
+			int lookerr = vnode_lookup(writable[i].path, 0, &vp, ctx);
+			if (lookerr != 0) {
+				attr_fail++;
+				if (badPath == 0) { badPath = writable[i].path; badError = lookerr; }
+				continue;
+			}
+			VATTR_INIT(&va);
+			VATTR_SET(&va, va_mode, writable[i].mode);
+			VATTR_SET(&va, va_uid, (uid_t)writable[i].uid);
+			VATTR_SET(&va, va_gid, (gid_t)writable[i].gid);
+			int seterr = vnode_setattr(vp, &va, ctx);
+			if (seterr == 0) {
+				attr_ok++;
+			} else {
+				attr_fail++;
+				if (badPath == 0) { badPath = writable[i].path; badError = seterr; }
+			}
+			vnode_put(vp);
+		}
+		printf("nabu: data tree attr=%u attrfail=%u first=%s err=%d\n",
+			    attr_ok, attr_fail, badPath ? badPath : "-", badError);
+		/* l615: re-arm datamigrator's own trigger, gated on sheng-mig=1. The sentinel is the
+		 * lever: the migrator removes /private/var/datamigrator/migrate once migration finishes,
+		 * which is why a page shown once never comes back. The preference is secondary and must
+		 * never be able to stop the boot -- this block has no return value and never panics, so a
+		 * failed write here is a printf, exactly like the preference writes above it. Both writes
+		 * truncate, so a second boot with the same token produces the same two files. */
+		{
+			int mig = 0;
+			PE_parse_boot_argn("sheng-mig", &mig, sizeof(mig));
+			if (mig == 1) {
+				static const char nabu_mig_force[] =
+					"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+					"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+					"<plist version=\"1.0\"><dict>"
+					"<key>forceMigrationOnNextReboot</key><true/>"
+					"<key>runSetupAssistant</key><true/>"
+					"</dict></plist>\n";
+				extern int nabu_kern_mkdir(const char *, int);
+				extern int nabu_kern_write_file_owner(const char *, const char *, size_t, int,
+				    uid_t, gid_t);
+				extern int nabu_kern_read_file_head(const char *, char *, size_t, size_t *,
+				    unsigned long long *, unsigned *);
+				int md = nabu_kern_mkdir("/private/var/datamigrator", 0755);
+				int sent = nabu_kern_write_file_owner("/private/var/datamigrator/migrate", "", 0,
+				    0644, 0, 0);
+				int prefs = nabu_kern_write_file_owner(
+				    "/private/var/mobile/Library/Preferences/com.apple.migration.plist",
+				    nabu_mig_force, sizeof(nabu_mig_force) - 1, 0600, 501, 501);
+				/* read-back of the sentinel: rc=0 with fsz=0 proves an empty file exists, which is
+				 * what the migrator tests for; a non-zero rc means the write did not land. */
+				static char mig_buf[8];
+				size_t mig_got = 0;
+				unsigned long long mig_fsz = 0;
+				unsigned mig_gset = 0;
+				int mig_rb = nabu_kern_read_file_head("/private/var/datamigrator/migrate", mig_buf,
+				    sizeof(mig_buf), &mig_got, &mig_fsz, &mig_gset);
+				printf("sheng-mig: sentinel=%d prefs=%d err=%d\n", sent, prefs,
+				    (md != 0 && md != 17) ? md : 0);
+				printf("sheng-mig: readback rc=%d fsz=%llu\n", mig_rb, mig_fsz);
+			}
+		}
+	}
 	if (!error) native_staged_apps_prepare(p, scratch, data_mount);
 done:
